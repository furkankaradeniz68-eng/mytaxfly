{
  "cleanUrls": true,
  "functions": {
    "api/stripe-webhook.js":   { "memory": 256, "maxDuration": 10 },
    "api/send-to-advisor.js":  { "maxDuration": 30 },
    "api/send-to-irs.js":      { "memory": 256, "maxDuration": 30 },
    "api/plaid-create-link-token.js": { "maxDuration": 10 },
    "api/plaid-exchange-token.js":   { "maxDuration": 10 },
    "api/plaid-sync.js":             { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/success", "destination": "/success.html" },
    { "source": "/imprint", "destination": "/legal.html" },
    { "source": "/privacy", "destination": "/legal.html" },
    { "source": "/tos", "destination": "/legal.html" },
    { "source": "/cookies", "destination": "/legal.html" },
    { "source": "/legal", "destination": "/legal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net https://cdn.plaid.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://open.er-api.com https://cdn.jsdelivr.net https://js.stripe.com https://*.plaid.com; frame-src https://js.stripe.com https://cdn.plaid.com; object-src 'none';"
        }
      ]
    }
  ]
}
